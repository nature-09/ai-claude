# lab-app 이미지
#   v1/v2   : 정상 버전 (APP_VERSION만 다름)
#   v3      : 기동 즉시 종료하는 고장 버전 (롤백 실습)  --build-arg BROKEN=true
#   legacy  : root(UID 0)가 아니면 기동하지 않는 80 포트 레거시 앱 (SCC 실습)
#             --build-arg APP_USER=0 --build-arg APP_PORT=80 --build-arg REQUIRE_ROOT=true
ARG BUILDER_IMAGE=registry.access.redhat.com/ubi9/go-toolset:latest
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:latest

FROM ${BUILDER_IMAGE} AS build
ARG VERSION=v1
ARG BROKEN=false
WORKDIR /opt/app-root/src
COPY go.mod main.go ./
RUN CGO_ENABLED=0 GOFLAGS=-mod=mod GOPROXY=off \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION} -X main.broken=${BROKEN}" -o /tmp/lab-app .

FROM ${RUNTIME_IMAGE}
ARG VERSION=v1
ARG APP_USER=1001
ARG APP_PORT=8080
ARG REQUIRE_ROOT=false
LABEL name="ocp-lab/lab-app" version="${VERSION}" \
      summary="OpenShift 실습용 샘플 애플리케이션" \
      io.openshift.expose-services="${APP_PORT}:http"
# curl 은 이미 있으면 그대로 사용 (curl / curl-minimal 충돌 방지)
RUN (command -v curl >/dev/null 2>&1 || microdnf install -y --nodocs curl-minimal) \
 && microdnf install -y --nodocs tar procps-ng && microdnf clean all \
 && mkdir -p /data /etc/app-config \
 && chgrp -R 0 /data && chmod -R g=u /data
COPY --from=build /tmp/lab-app /usr/local/bin/lab-app
ENV PORT=${APP_PORT} DATA_DIR=/data CONFIG_DIR=/etc/app-config REQUIRE_ROOT=${REQUIRE_ROOT}
EXPOSE ${APP_PORT} 8443 9000
USER ${APP_USER}
CMD ["/usr/local/bin/lab-app"]
