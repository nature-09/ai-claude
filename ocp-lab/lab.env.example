# ocp-lab 설정 파일 — bastion 의 /etc/ocp-lab/lab.env 로 복사해서 사용
# 형식: KEY=VALUE (따옴표 없이). 사용자별로 ~/.ocp-lab/lab.env 에서 덮어쓸 수 있고,
# 같은 이름의 환경 변수가 있으면 그 값이 우선합니다.

# [필수] 실습 이미지를 올린 사내 레지스트리 (포트 포함)
LAB_REGISTRY=registry.corp.local:5000
# 레지스트리 안의 경로(조직/프로젝트). 모든 실습 이미지가 <LAB_REGISTRY>/<LAB_REPO_PREFIX>/... 에 있음
LAB_REPO_PREFIX=ocp-lab

# OCP API 주소 (lab login 에서 사용)
LAB_API_URL=https://api.ocp.corp.local:6443
# API 인증서 검증 생략 여부 (사내 CA 파일이 있으면 LAB_API_CA 에 경로 지정하고 false)
LAB_INSECURE_TLS=true
#LAB_API_CA=/etc/pki/ca-trust/source/anchors/ocp-api-ca.crt

# 여러 수강생이 클러스터를 함께 쓰면 true (클러스터 전체 설정 과제 일부를 강사 시연으로 돌림)
LAB_SHARED=true

# ex280-14 에서 설치할 오퍼레이터 (OwnNamespace 설치를 지원해야 함)
LAB_OPERATOR_PACKAGE=rhbk-operator

# 툴박스 이미지 pull 시 TLS 검증 (사설 인증서 레지스트리이고 CA 를 신뢰하지 않으면 false)
#LAB_TLS_VERIFY=true
